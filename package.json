{
  "name": "fumadocs-page-history-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "plugin-build": "pnpm --filter fumadocs-page-history build",
    "docs-dev": "pnpm plugin-build && pnpm --filter fumadocs-page-history-docs dev",
    "docs-build": "pnpm plugin-build && pnpm --filter fumadocs-page-history-docs build",
    "build": "pnpm docs-build",
    "dev": "pnpm docs-dev",
    "test": "pnpm plugin-build && vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm plugin-build && pnpm -r types:check",
    "lint": "oxlint .",
    "format": "oxfmt",
    "lint:format": "oxfmt --check",
    "changeset": "changeset",
    "check": "pnpm lint:format && pnpm lint && pnpm test && pnpm typecheck && pnpm docs-build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "26.6.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@12.8.1"
}
